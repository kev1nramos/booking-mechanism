{
  "name": "@kev1nramos/booking-mechanism",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable Google Calendar booking system for Next.js + Cloudflare Pages Functions",
  "repository": {
    "type": "git",
    "url": "https://github.com/kev1nramos/booking-mechanism.git"
  },
  "author": "Kevin Ramos",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "publish-packages": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "typescript": "^5.3.3"
  }
}
